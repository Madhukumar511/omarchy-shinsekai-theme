#!/usr/bin/env python3
import sys, os, subprocess, urllib.request, urllib.parse, re, shutil, shlex

THEME_DIR = os.path.expanduser("~/.config/omarchy/themes/shinsekai")
BG_DIR = os.path.join(THEME_DIR, "backgrounds")
DYNAMIC_SCRIPT = os.path.join(THEME_DIR, "dynamic-theme.py")

def print_banner():
    print("""
\033[1;36m🌸 Shinsekai Wallpaper Manager\033[0m
\033[2mInstant 4K/8K anime wallpaper downloader & real-time dynamic color sync.\033[0m
""")

def print_commands_menu():
    print("""\033[1;33mAvailable Commands:\033[0m
  \033[1;32madd <url-or-path> [name]\033[0m   Add & download wallpaper (auto-assigned next number)
  \033[1;32mlist\033[0m                      View all wallpapers with their assigned numbers
  \033[1;32mset <number>\033[0m              Switch active wallpaper by number (e.g. \033[36mset 4\033[0m)
  \033[1;32mremove <number>\033[0m           Delete wallpaper by number (e.g. \033[36mremove 13\033[0m)
  \033[1;32mnext\033[0m                      Cycle to next wallpaper
  \033[1;32mcurrent\033[0m                   Show currently active wallpaper
  \033[1;32mexit\033[0m                      Exit manager
""")

def get_clipboard_text():
    try:
        res = subprocess.run(["wl-paste"], capture_output=True, text=True, timeout=1)
        if res.returncode == 0:
            return res.stdout.strip()
    except Exception:
        pass
    return ""

def resolve_smart_url(url):
    url = url.strip().strip("'\"")
    
    # 1. Google Images URL unpack
    if "google." in url and "imgurl=" in url:
        parsed = urllib.parse.urlparse(url)
        params = urllib.parse.parse_qs(parsed.query)
        if "imgurl" in params:
            real_url = params["imgurl"][0]
            print(f"\033[1;33m🔍 Extracted direct image from Google Images:\033[0m {real_url}")
            return real_url

    # 2. Wallhaven page URL unpack (e.g. wallhaven.cc/w/z8opey)
    m = re.search(r'wallhaven\.cc/w/([a-z0-9]+)', url)
    if m:
        wid = m.group(1)
        api_url = f"https://wallhaven.cc/api/v1/w/{wid}"
        try:
            req = urllib.request.Request(api_url, headers={'User-Agent': 'Mozilla/5.0'})
            with urllib.request.urlopen(req, timeout=5) as resp:
                import json
                data = json.loads(resp.read().decode('utf-8'))
                direct_path = data['data']['path']
                print(f"\033[1;33m🔍 Resolved full Wallhaven 4K/8K path:\033[0m {direct_path}")
                return direct_path
        except Exception:
            pass

    # 3. WallpaperFlare page URL unpack
    if "wallpaperflare.com" in url and not url.endswith(('.jpg', '.jpeg', '.png', '.webp')):
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
            with urllib.request.urlopen(req, timeout=5) as resp:
                html = resp.read().decode('utf-8', errors='ignore')
                img_match = re.search(r'<img[^>]+id=[\'"]show_img[\'"][^>]+src=[\'"]([^\'"]+)[\'"]', html)
                if not img_match:
                    img_match = re.search(r'data-src=[\'"](https://c4\.wallpaperflare\.com/wallpaper/[^\'"]+)[\'"]', html)
                if img_match:
                    direct_img = img_match.group(1)
                    print(f"\033[1;33m🔍 Resolved full WallpaperFlare image:\033[0m {direct_img}")
                    return direct_img
        except Exception:
            pass

    return url

def get_image_info(path):
    cmd = f'magick identify -format "%w %h %m %b" "{path}"'
    res = subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout.strip()
    parts = res.split()
    if len(parts) >= 4:
        return int(parts[0]), int(parts[1]), parts[2], parts[3]
    return 0, 0, "UNKNOWN", "0B"

def reindex_wallpapers():
    """Ensures all wallpapers have clean sequential numbers (01, 02, 03...)."""
    if not os.path.exists(BG_DIR):
        return []
    files = sorted([f for f in os.listdir(BG_DIR) if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp'))])
    return files

def add_wallpaper(source, custom_name=None):
    if not source:
        print("\033[1;31m❌ Error: Please provide an image URL or local file path.\033[0m")
        return

    # Clean any accidental command wrappers pasted by user (e.g. shin-bg add "...")
    source = re.sub(r'^(shin-bg|shinsekai-wallpaper|shinsekai)\s+(add\s+)?', '', source).strip().strip("'\"")

    os.makedirs(BG_DIR, exist_ok=True)
    temp_file = "/tmp/shinsekai_temp_download"
    if os.path.exists(temp_file):
        try: os.remove(temp_file)
        except: pass

    clean_source = resolve_smart_url(source)

    # 1. Download or Copy
    if clean_source.startswith("http://") or clean_source.startswith("https://"):
        print(f"\033[1;34m⬇️ Downloading wallpaper:\033[0m {clean_source}")
        headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'}
        req = urllib.request.Request(clean_source, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=15) as resp, open(temp_file, "wb") as f:
                f.write(resp.read())
        except Exception as e:
            print(f"\033[1;31m❌ Download failed: {e}\033[0m")
            return
    else:
        src_path = os.path.expanduser(clean_source)
        if not os.path.exists(src_path):
            print(f"\033[1;31m❌ Local file not found: {src_path}\033[0m")
            return
        shutil.copy2(src_path, temp_file)

    # 2. Quality & Resolution Check
    w, h, fmt, size = get_image_info(temp_file)
    if w == 0 or h == 0:
        print("\033[1;31m❌ Invalid or unreadable image file.\033[0m")
        return

    print(f"\033[1;34m🔍 Resolution:\033[0m {w}x{h} ({fmt}) | Size: {size}")

    if w >= 3840 and h >= 2160:
        print(f"\033[1;32m✅ Quality Check Passed:\033[0m Native 4K/8K Ultra HD ({w}x{h})")
    elif w >= 2560 and h >= 1440:
        print(f"\033[1;32m✅ Quality Check Passed:\033[0m High Quality 2K QHD ({w}x{h})")
    elif w >= 1920 and h >= 1080:
        print(f"\033[1;33m⚠️ 1080p FHD Detected:\033[0m Sharp-scaling to 4K canvas.")
    else:
        print(f"\033[1;31m⚠️ Low Resolution ({w}x{h}):\033[0m Upscaling to 4K canvas.")

    # 3. Automatically assign next sequential number
    existing_files = reindex_wallpapers()
    next_idx = len(existing_files) + 1

    if custom_name:
        clean_name = re.sub(r'[^a-zA-Z0-9_-]', '-', custom_name).strip('-').lower()
        target_filename = f"{next_idx:02d}-{clean_name}.jpg"
    else:
        url_leaf = os.path.splitext(os.path.basename(clean_source.split('?')[0]))[0]
        url_leaf = re.sub(r'[^a-zA-Z0-9_-]', '-', url_leaf).strip('-').lower()
        if len(url_leaf) > 3 and not url_leaf.startswith("wallpaper"):
            target_filename = f"{next_idx:02d}-{url_leaf[:24]}.jpg"
        else:
            target_filename = f"{next_idx:02d}-custom-wallpaper.jpg"

    dest_path = os.path.join(BG_DIR, target_filename)

    # 4. Process and save
    print("\033[1;34m⚙️ Processing & saving 4K UHD wallpaper...\033[0m")
    subprocess.run(f'magick "{temp_file}" -resize 3840x2160^ -gravity center -extent 3840x2160 -quality 95 "{dest_path}"', shell=True)
    if os.path.exists(temp_file):
        try: os.remove(temp_file)
        except: pass

    print(f"\033[1;32m🎉 Added Wallpaper #{next_idx:02d}:\033[0m {target_filename} ({os.path.getsize(dest_path)} bytes)")

    # 5. Set active & trigger dynamic color adaptation
    subprocess.run(f'omarchy theme bg set "{dest_path}"', shell=True)
    if os.path.exists(DYNAMIC_SCRIPT):
        subprocess.run(f'python3 "{DYNAMIC_SCRIPT}" "{dest_path}"', shell=True)
    print("\033[1;35m✨ Theme colors dynamically synchronized across all apps!\033[0m")

def list_wallpapers():
    files = reindex_wallpapers()
    if not files:
        print("No wallpapers found.")
        return

    current_link = os.path.expanduser("~/.local/state/omarchy/current/background")
    active_real = os.path.realpath(current_link) if os.path.exists(current_link) else ""

    print(f"\n\033[1;36m🌸 Shinsekai Wallpapers ({len(files)} total):\033[0m\n")
    for idx, f in enumerate(files, 1):
        p = os.path.join(BG_DIR, f)
        w, h, _, size = get_image_info(p)
        is_active = " \033[1;32m[ACTIVE]\033[0m" if os.path.realpath(p) == active_real else ""
        print(f"  \033[1;33m[{idx:02d}]\033[0m {f:<38} \033[1;34m{w}x{h}\033[0m ({size}){is_active}")
    print()

def remove_wallpaper(target):
    files = reindex_wallpapers()
    to_delete = None

    target = str(target).strip()
    if target.isdigit():
        idx = int(target) - 1
        if 0 <= idx < len(files):
            to_delete = files[idx]
    else:
        for f in files:
            if target.lower() in f.lower():
                to_delete = f
                break

    if not to_delete:
        print(f"\033[1;31m❌ Wallpaper #{target} not found. Run 'list' to view numbers.\033[0m")
        return

    del_path = os.path.join(BG_DIR, to_delete)
    os.remove(del_path)
    print(f"\033[1;32m🗑️ Removed wallpaper:\033[0m {to_delete}")
    subprocess.run("omarchy theme bg next 2>/dev/null || true", shell=True)

def set_wallpaper(target):
    files = reindex_wallpapers()
    chosen = None

    target = str(target).strip()
    if target.isdigit():
        idx = int(target) - 1
        if 0 <= idx < len(files):
            chosen = files[idx]
    else:
        for f in files:
            if target.lower() in f.lower():
                chosen = f
                break

    if not chosen:
        print(f"\033[1;31m❌ Wallpaper #{target} not found. Run 'list' to view numbers.\033[0m")
        return

    p = os.path.join(BG_DIR, chosen)
    subprocess.run(f'omarchy theme bg set "{p}"', shell=True)
    if os.path.exists(DYNAMIC_SCRIPT):
        subprocess.run(f'python3 "{DYNAMIC_SCRIPT}" "{p}"', shell=True)
    print(f"\033[1;32m✨ Active wallpaper set to [{int(target) if target.isdigit() else 0:02d}]:\033[0m {chosen}")

def parse_and_execute(cmd_line):
    cmd_line = cmd_line.strip()
    if not cmd_line:
        return

    # Split using shell lexer to handle quotes cleanly
    try:
        parts = shlex.split(cmd_line)
    except Exception:
        parts = cmd_line.split()

    if not parts:
        return

    # Strip executable name if user typed it (e.g. shin-bg or shinsekai-wallpaper)
    if parts[0] in ["shin-bg", "shinsekai-wallpaper", "shinsekai"]:
        parts = parts[1:]
        if not parts:
            return

    action = parts[0].lower()

    if action in ["add", "download", "new", "1"]:
        src = parts[1] if len(parts) > 1 else ""
        name = parts[2] if len(parts) > 2 else None
        if not src:
            src = input("\033[1;36mEnter Image URL or Path: \033[0m").strip()
            name = input("\033[1;36mWallpaper Name (optional): \033[0m").strip() or None
        add_wallpaper(src, name)
    elif action in ["list", "ls", "2"]:
        list_wallpapers()
    elif action in ["set", "select", "apply", "3"]:
        target = parts[1] if len(parts) > 1 else ""
        if not target:
            target = input("\033[1;36mEnter Wallpaper Number (e.g. 3): \033[0m").strip()
        set_wallpaper(target)
    elif action in ["remove", "rm", "delete", "del", "4"]:
        target = parts[1] if len(parts) > 1 else ""
        if not target:
            target = input("\033[1;36mEnter Wallpaper Number to Remove: \033[0m").strip()
        remove_wallpaper(target)
    elif action in ["next", "cycle", "5"]:
        subprocess.run("omarchy theme bg next", shell=True)
    elif action in ["current", "status"]:
        subprocess.run("omarchy theme bg current", shell=True)
    elif action in ["exit", "quit", "q", "6"]:
        print("Exiting.")
        sys.exit(0)
    elif action.isdigit():
        # If user just typed a number like '3', switch to that wallpaper!
        set_wallpaper(action)
    elif action.startswith("http://") or action.startswith("https://") or os.path.exists(os.path.expanduser(action)):
        # If user directly pasted a URL/path
        name = parts[1] if len(parts) > 1 else None
        add_wallpaper(action, name)
    else:
        print(f"\033[1;31mUnknown command '{action}'. Type 'list', 'set <number>', 'add <url>', or 'remove <number>'.\033[0m")

def interactive_loop():
    print_banner()
    print_commands_menu()
    
    clip = get_clipboard_text()
    if clip.startswith("http://") or clip.startswith("https://") or (os.path.exists(os.path.expanduser(clip)) and clip.lower().endswith(('.jpg', '.png', '.jpeg', '.webp'))):
        print(f"\033[1;33m📋 Detected image link in clipboard:\033[0m {clip}")
        use_clip = input("\033[1mDownload & add this clipboard wallpaper now? [Y/n]: \033[0m").strip().lower()
        if use_clip in ["", "y", "yes"]:
            name = input("\033[1mWallpaper Name (optional, press Enter to auto-name): \033[0m").strip() or None
            add_wallpaper(clip, name)
            return

    while True:
        try:
            line = input("\033[1;36mshin-bg > \033[0m").strip()
            if not line:
                continue
            parse_and_execute(line)
        except (KeyboardInterrupt, EOFError):
            print("\nExiting.")
            break

def main():
    if len(sys.argv) < 2:
        interactive_loop()
        return

    # Parse command line arguments directly
    full_cmd = " ".join(sys.argv[1:])
    parse_and_execute(full_cmd)

if __name__ == "__main__":
    main()
