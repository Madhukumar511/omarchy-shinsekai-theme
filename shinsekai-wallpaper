#!/usr/bin/env python3
import sys, os, subprocess, urllib.request, urllib.parse, re, shutil, shlex, time, json

THEME_DIR = os.path.expanduser("~/.config/omarchy/themes/shinsekai")
BG_DIR = os.path.join(THEME_DIR, "backgrounds")
ACTIVE_BG_DIR = os.path.expanduser("~/.local/state/omarchy/current/theme/backgrounds")
TRASH_DIR = os.path.join(THEME_DIR, ".trash")
DYNAMIC_SCRIPT = os.path.join(THEME_DIR, "dynamic-theme.py")
TRASH_HISTORY_FILE = os.path.join(TRASH_DIR, "history.json")

def print_banner():
    print("""
\033[1;36m🌸 Shinsekai Wallpaper Manager\033[0m
\033[2mInstant 4K/8K anime wallpaper downloader, trash recovery & zero-CPU dynamic color sync.\033[0m
""")

def print_commands_menu():
    total = len(get_all_wallpapers())
    max_label = f"[01-{total:02d}]" if total > 0 else "[01-N]"
    print(f"""\033[1;33mAvailable Commands:\033[0m
  \033[1;32madd <url-or-path> [name]\033[0m   Download & add 4K wallpaper (auto-assigned next sequential number)
  \033[1;32mlist\033[0m                      View all wallpapers with their assigned numbers {max_label}
  \033[1;32mset <number>\033[0m              Switch active wallpaper by number (e.g. \033[36mset 4\033[0m)
  \033[1;32mremove <number>\033[0m           Delete wallpaper to recovery trash (e.g. \033[36mremove 13\033[0m)
  \033[1;32mrestore [number]\033[0m          Undo / Restore deleted wallpaper (e.g. \033[36mrestore 13\033[0m or \033[36mundo\033[0m)
  \033[1;32mtrash\033[0m                     View deleted wallpapers in recovery trash
  \033[1;32mnext\033[0m                      Cycle to next wallpaper
  \033[1;32mcurrent\033[0m                   Show currently active wallpaper
  \033[1;32mexit\033[0m                      Exit manager
""")

def get_clipboard_text():
    try:
        res = subprocess.run(["wl-paste"], capture_output=True, text=True, timeout=1)
        if res.returncode == 0:
            return res.stdout.strip()
    except Exception:
        pass
    return ""

def resolve_smart_url(url):
    url = url.strip().strip("'\"")
    if "google." in url and "imgurl=" in url:
        parsed = urllib.parse.urlparse(url)
        params = urllib.parse.parse_qs(parsed.query)
        if "imgurl" in params:
            real_url = params["imgurl"][0]
            print(f"\033[1;33m🔍 Extracted direct image from Google Images:\033[0m {real_url}")
            return real_url

    m = re.search(r'wallhaven\.cc/w/([a-z0-9]+)', url)
    if m:
        wid = m.group(1)
        api_url = f"https://wallhaven.cc/api/v1/w/{wid}"
        try:
            req = urllib.request.Request(api_url, headers={'User-Agent': 'Mozilla/5.0'})
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = json.loads(resp.read().decode('utf-8'))
                direct_path = data['data']['path']
                print(f"\033[1;33m🔍 Resolved full Wallhaven 4K/8K image:\033[0m {direct_path}")
                return direct_path
        except Exception:
            pass

    return url

def download_file_with_curl(url, dest):
    user_agent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
    cmd = [
        "curl", "-s", "-L", "--fail",
        "-A", user_agent,
        "--referer", url,
        "--compressed",
        "--connect-timeout", "10",
        "--max-time", "30",
        "-o", dest,
        url
    ]
    res = subprocess.run(cmd, capture_output=True, text=True)
    return res.returncode == 0

def get_image_info(path):
    cmd = f'magick identify -format "%w %h %m %b" "{path}"'
    res = subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout.strip()
    parts = res.split()
    if len(parts) >= 4:
        return int(parts[0]), int(parts[1]), parts[2], parts[3]
    return 0, 0, "UNKNOWN", "0B"

def get_all_wallpapers():
    if not os.path.exists(BG_DIR):
        return []
    return sorted([f for f in os.listdir(BG_DIR) if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp'))])

def load_trash_history():
    if os.path.exists(TRASH_HISTORY_FILE):
        try:
            with open(TRASH_HISTORY_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return []

def save_trash_history(history):
    os.makedirs(TRASH_DIR, exist_ok=True)
    with open(TRASH_HISTORY_FILE, "w") as f:
        json.dump(history, f, indent=2)

def refresh_wallpaper_cache():
    subprocess.run("omarchy-theme-bg-cache >/dev/null 2>&1 &", shell=True)

def add_wallpaper(source, custom_name=None):
    if not source:
        print("\033[1;31m❌ Error: Please provide an image URL or local file path.\033[0m")
        return

    source = re.sub(r'^(shin-bg|shinsekai-wallpaper|shinsekai)\s+(add\s+)?', '', source).strip().strip("'\"")

    os.makedirs(BG_DIR, exist_ok=True)
    temp_file = "/tmp/shinsekai_temp_download"
    if os.path.exists(temp_file):
        try: os.remove(temp_file)
        except: pass

    clean_source = resolve_smart_url(source)

    if clean_source.startswith("http://") or clean_source.startswith("https://"):
        print(f"\033[1;34m⬇️ Downloading wallpaper:\033[0m {clean_source}")
        ok = download_file_with_curl(clean_source, temp_file)
        if not ok or not os.path.exists(temp_file) or os.path.getsize(temp_file) == 0:
            print(f"\033[1;31m❌ Download failed (Forbidden / Blocked by website protection).\033[0m")
            print("""
\033[1;33m💡 Quick Fix for Webpage Links:\033[0m
  You pasted a website page URL instead of the direct image file.
  \033[1;32m👉 Right-click the image in your browser\033[0m and choose:
     \033[1m• 'Copy image address'\033[0m (or 'Copy image link')
  Then paste it into \033[1;36mshin-bg\033[0m!

  \033[1;32m👉 Or download the image to ~/Downloads and run:\033[0m
     \033[1;36mshin-bg add ~/Downloads/my-image.jpg\033[0m
""")
            return
    else:
        src_path = os.path.expanduser(clean_source)
        if not os.path.exists(src_path):
            print(f"\033[1;31m❌ Local file not found: {src_path}\033[0m")
            return
        shutil.copy2(src_path, temp_file)

    w, h, fmt, size = get_image_info(temp_file)
    if w == 0 or h == 0:
        print("\033[1;31m❌ Downloaded file is not a valid image.\033[0m")
        return

    print(f"\033[1;34m🔍 Resolution:\033[0m {w}x{h} ({fmt}) | Size: {size}")

    if w >= 3840 and h >= 2160:
        print(f"\033[1;32m✅ Quality Check Passed:\033[0m Native 4K/8K Ultra HD ({w}x{h})")
    elif w >= 2560 and h >= 1440:
        print(f"\033[1;32m✅ Quality Check Passed:\033[0m High Quality 2K QHD ({w}x{h})")
    elif w >= 1920 and h >= 1080:
        print(f"\033[1;33m⚠️ 1080p FHD Detected:\033[0m Sharp-scaling to 4K canvas.")
    else:
        print(f"\033[1;31m⚠️ Low Resolution ({w}x{h}):\033[0m Upscaling to 4K canvas.")

    existing_files = get_all_wallpapers()
    next_idx = len(existing_files) + 1

    if custom_name:
        clean_name = re.sub(r'[^a-zA-Z0-9_-]', '-', custom_name).strip('-').lower()
        target_filename = f"{next_idx:02d}-{clean_name}.jpg"
    else:
        url_leaf = os.path.splitext(os.path.basename(clean_source.split('?')[0]))[0]
        url_leaf = re.sub(r'[^a-zA-Z0-9_-]', '-', url_leaf).strip('-').lower()
        if len(url_leaf) > 3 and not url_leaf.startswith("wallpaper"):
            target_filename = f"{next_idx:02d}-{url_leaf[:24]}.jpg"
        else:
            target_filename = f"{next_idx:02d}-custom-wallpaper.jpg"

    dest_path = os.path.join(BG_DIR, target_filename)

    print("\033[1;34m⚙️ Processing & saving 4K UHD wallpaper...\033[0m")
    subprocess.run(f'magick "{temp_file}" -resize 3840x2160^ -gravity center -extent 3840x2160 -quality 95 "{dest_path}"', shell=True)
    if os.path.exists(temp_file):
        try: os.remove(temp_file)
        except: pass

    # Sync to active runtime theme backgrounds directory
    if os.path.exists(ACTIVE_BG_DIR):
        active_dest = os.path.join(ACTIVE_BG_DIR, target_filename)
        shutil.copy2(dest_path, active_dest)

    # Refresh Walker thumbnail cache for SUPER + CTRL + SPACE
    refresh_wallpaper_cache()

    print(f"\033[1;32m🎉 Added Wallpaper #{next_idx:02d}:\033[0m {target_filename} ({os.path.getsize(dest_path)} bytes)")

    subprocess.run(f'omarchy theme bg set "{dest_path}"', shell=True)
    if os.path.exists(DYNAMIC_SCRIPT):
        subprocess.run(f'python3 "{DYNAMIC_SCRIPT}" "{dest_path}"', shell=True)
    print("\033[1;35m✨ Active wallpaper set, thumbnail cached & colors synchronized across all apps!\033[0m")

def list_wallpapers():
    files = get_all_wallpapers()
    if not files:
        print("No wallpapers found.")
        return

    current_link = os.path.expanduser("~/.local/state/omarchy/current/background")
    active_real = os.path.realpath(current_link) if os.path.exists(current_link) else ""

    print(f"\n\033[1;36m🌸 Shinsekai Wallpapers ({len(files)} total):\033[0m\n")
    for idx, f in enumerate(files, 1):
        p = os.path.join(BG_DIR, f)
        w, h, _, size = get_image_info(p)
        is_active = " \033[1;32m[ACTIVE]\033[0m" if os.path.realpath(p) == active_real else ""
        print(f"  \033[1;33m[{idx:02d}]\033[0m {f:<38} \033[1;34m{w}x{h}\033[0m ({size}){is_active}")
    print()

def remove_wallpaper(target):
    files = get_all_wallpapers()
    to_delete = None

    target_str = str(target).strip()
    if target_str.isdigit():
        target_num = int(target_str)
        for f in files:
            if f.startswith(f"{target_num:02d}-"):
                to_delete = f
                break
        if not to_delete and 1 <= target_num <= len(files):
            to_delete = files[target_num - 1]
    else:
        for f in files:
            if target_str.lower() in f.lower():
                to_delete = f
                break

    if not to_delete:
        print(f"\033[1;31m❌ Wallpaper #{target} not found. Run 'list' to view numbers.\033[0m")
        return

    os.makedirs(TRASH_DIR, exist_ok=True)
    src_path = os.path.join(BG_DIR, to_delete)
    trash_path = os.path.join(TRASH_DIR, to_delete)
    shutil.move(src_path, trash_path)

    # Also remove from active state dir
    if os.path.exists(ACTIVE_BG_DIR):
        active_src = os.path.join(ACTIVE_BG_DIR, to_delete)
        if os.path.exists(active_src):
            try: os.remove(active_src)
            except: pass

    history = load_trash_history()
    history.append({
        "filename": to_delete,
        "deleted_at": time.time()
    })
    save_trash_history(history)
    refresh_wallpaper_cache()

    print(f"\033[1;32m🗑️ Moved to recovery trash:\033[0m {to_delete}")
    print(f"\033[2m💡 Mistake? Type \033[1;36mshin-bg restore {to_delete[:2]}\033[0m\033[2m or \033[1;36mshin-bg undo\033[0m\033[2m anytime to restore it!\033[0m")
    subprocess.run("omarchy theme bg next 2>/dev/null || true", shell=True)

def restore_wallpaper(target=None):
    history = load_trash_history()
    if not history:
        print("\033[1;33mℹ️ Recovery trash is empty. No deleted wallpapers to restore.\033[0m")
        return

    to_restore_entry = None
    target_str = str(target).strip() if target else ""

    if target_str:
        if target_str.isdigit():
            target_num = int(target_str)
            for item in reversed(history):
                if item["filename"].startswith(f"{target_num:02d}-"):
                    to_restore_entry = item
                    break
        else:
            for item in reversed(history):
                if target_str.lower() in item["filename"].lower():
                    to_restore_entry = item
                    break
    else:
        to_restore_entry = history[-1]

    if not to_restore_entry:
        print(f"\033[1;31m❌ Wallpaper #{target} not found in recovery trash. Type 'trash' to view deleted files.\033[0m")
        return

    filename = to_restore_entry["filename"]
    trash_path = os.path.join(TRASH_DIR, filename)
    dest_path = os.path.join(BG_DIR, filename)

    if not os.path.exists(trash_path):
        print(f"\033[1;31m❌ File not found in trash: {filename}\033[0m")
        return

    shutil.move(trash_path, dest_path)
    if os.path.exists(ACTIVE_BG_DIR):
        shutil.copy2(dest_path, os.path.join(ACTIVE_BG_DIR, filename))

    history = [h for h in history if h["filename"] != filename]
    save_trash_history(history)
    refresh_wallpaper_cache()

    print(f"\033[1;32m🎉 Restored Wallpaper:\033[0m {filename}")
    subprocess.run(f'omarchy theme bg set "{dest_path}"', shell=True)
    if os.path.exists(DYNAMIC_SCRIPT):
        subprocess.run(f'python3 "{DYNAMIC_SCRIPT}" "{dest_path}"', shell=True)
    print("\033[1;35m✨ Active wallpaper set and colors dynamically updated!\033[0m")

def list_trash():
    history = load_trash_history()
    if not history:
        print("\033[1;33mℹ️ Recovery trash is empty.\033[0m")
        return

    print(f"\n\033[1;36m🗑️ Recovery Trash ({len(history)} items):\033[0m\n")
    for idx, item in enumerate(history, 1):
        fn = item["filename"]
        ago = int((time.time() - item.get("deleted_at", time.time())) / 60)
        ago_str = f"{ago}m ago" if ago > 0 else "just now"
        print(f"  \033[1;33m[{fn[:2]}]\033[0m {fn:<38} \033[2m(Deleted {ago_str})\033[0m")
    print(f"\n\033[2mRun \033[1;36mshin-bg restore <number>\033[0m\033[2m to restore any item.\033[0m\n")

def set_wallpaper(target):
    files = get_all_wallpapers()
    chosen = None

    target_str = str(target).strip()
    if target_str.isdigit():
        target_num = int(target_str)
        for f in files:
            if f.startswith(f"{target_num:02d}-"):
                chosen = f
                break
        if not chosen and 1 <= target_num <= len(files):
            chosen = files[target_num - 1]
    else:
        for f in files:
            if target_str.lower() in f.lower():
                chosen = f
                break

    if not chosen:
        print(f"\033[1;31m❌ Wallpaper #{target} not found. Run 'list' to view numbers.\033[0m")
        return

    p = os.path.join(BG_DIR, chosen)
    subprocess.run(f'omarchy theme bg set "{p}"', shell=True)
    if os.path.exists(DYNAMIC_SCRIPT):
        subprocess.run(f'python3 "{DYNAMIC_SCRIPT}" "{p}"', shell=True)
    print(f"\033[1;32m✨ Active wallpaper set to [{chosen[:2]}]:\033[0m {chosen}")

def parse_and_execute(cmd_line):
    cmd_line = cmd_line.strip()
    if not cmd_line:
        return

    try:
        parts = shlex.split(cmd_line)
    except Exception:
        parts = cmd_line.split()

    if not parts:
        return

    if parts[0] in ["shin-bg", "shinsekai-wallpaper", "shinsekai"]:
        parts = parts[1:]
        if not parts:
            print_commands_menu()
            return

    action = parts[0].lower()

    if action in ["add", "download", "new", "1"]:
        src = parts[1] if len(parts) > 1 else ""
        name = parts[2] if len(parts) > 2 else None
        if not src:
            src = input("\033[1;36mEnter Image URL or Path: \033[0m").strip()
            name = input("\033[1;36mWallpaper Name (optional): \033[0m").strip() or None
        add_wallpaper(src, name)
    elif action in ["list", "ls", "2"]:
        list_wallpapers()
    elif action in ["set", "select", "apply", "3"]:
        target = parts[1] if len(parts) > 1 else ""
        if not target:
            target = input("\033[1;36mEnter Wallpaper Number (e.g. 3): \033[0m").strip()
        set_wallpaper(target)
    elif action in ["remove", "rm", "delete", "del", "4"]:
        target = parts[1] if len(parts) > 1 else ""
        if not target:
            target = input("\033[1;36mEnter Wallpaper Number to Remove: \033[0m").strip()
        remove_wallpaper(target)
    elif action in ["restore", "undo", "redo", "recover", "5"]:
        target = parts[1] if len(parts) > 1 else None
        restore_wallpaper(target)
    elif action in ["trash", "bin", "history", "6"]:
        list_trash()
    elif action in ["next", "cycle", "7"]:
        subprocess.run("omarchy theme bg next", shell=True)
    elif action in ["current", "status"]:
        subprocess.run("omarchy theme bg current", shell=True)
    elif action in ["help", "-h", "--help", "menu"]:
        print_commands_menu()
    elif action in ["exit", "quit", "q", "8"]:
        print("Exiting.")
        sys.exit(0)
    elif action.isdigit():
        set_wallpaper(action)
    elif action.startswith("http://") or action.startswith("https://") or os.path.exists(os.path.expanduser(action)):
        name = parts[1] if len(parts) > 1 else None
        add_wallpaper(action, name)
    else:
        print(f"\033[1;31mUnknown command '{action}'. Type 'list', 'set <number>', 'add <url>', or 'remove <number>'.\033[0m")

def interactive_loop():
    print_banner()
    print_commands_menu()
    
    clip = get_clipboard_text()
    if clip.startswith("http://") or clip.startswith("https://") or (os.path.exists(os.path.expanduser(clip)) and clip.lower().endswith(('.jpg', '.png', '.jpeg', '.webp'))):
        print(f"\033[1;33m📋 Detected link/file in clipboard:\033[0m {clip}")
        use_clip = input("\033[1mDownload & add this clipboard wallpaper now? [Y/n]: \033[0m").strip().lower()
        if use_clip in ["", "y", "yes"]:
            name = input("\033[1mWallpaper Name (optional, press Enter to auto-name): \033[0m").strip() or None
            add_wallpaper(clip, name)
            return

    while True:
        try:
            line = input("\033[1;36mshin-bg > \033[0m").strip()
            if not line:
                continue
            parse_and_execute(line)
        except (KeyboardInterrupt, EOFError):
            print("\nExiting.")
            break

def main():
    if len(sys.argv) < 2:
        interactive_loop()
        return

    full_cmd = " ".join(sys.argv[1:])
    parse_and_execute(full_cmd)

if __name__ == "__main__":
    main()
