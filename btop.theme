# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""
theme_background=false

# Main text color
theme[main_fg]="#f1f5f9"

# Title color for boxes
theme[title]="#ff6d00"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ffd600"

# Background color of selected item in processes box
theme[selected_bg]="#1e293b"

# Foreground color of selected item in processes box
theme[selected_fg]="#f1f5f9"

# Color of inactive/disabled text
theme[inactive_fg]="#475569"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#00b0ff"

# Box outline and divider line color
theme[cpu_box]="#ff6d00"
theme[mem_box]="#00b0ff"
theme[net_box]="#00e676"
theme[proc_box]="#ff2a55"
theme[div_line]="#334155"

# Gradient for all meters and graphs
theme[temp_start]="#00e676"
theme[temp_mid]="#ffd600"
theme[temp_end]="#ff2a55"

theme[cpu_start]="#00b0ff"
theme[cpu_mid]="#ff6d00"
theme[cpu_end]="#ff2a55"

theme[free_start]="#00e676"
theme[free_mid]="#00e5ff"
theme[free_end]="#00b0ff"

theme[cached_start]="#00b0ff"
theme[cached_mid]="#00e5ff"
theme[cached_end]="#00e676"

theme[available_start]="#00e676"
theme[available_mid]="#00e5ff"
theme[available_end]="#00b0ff"

theme[used_start]="#00b0ff"
theme[used_mid]="#ff6d00"
theme[used_end]="#ff2a55"

theme[download_start]="#00e676"
theme[download_mid]="#00e5ff"
theme[download_end]="#00b0ff"

theme[upload_start]="#00b0ff"
theme[upload_mid]="#ff6d00"
theme[upload_end]="#ff2a55"
